{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set selectedSubnavItem = 'rules' %}
{% set fullPageForm = true %}
{% set crumbs = [{ label: "Friends"|t('friends'), url: url('friends/rules') }] %}

{% set tabs = {
    what: { label: "What it does"|t('friends'), url: '#what-tab' },
    when: { label: "When it applies"|t('friends'), url: '#when-tab' },
    where: { label: "Where it may point"|t('friends'), url: '#where-tab' },
    how: { label: "How sure it must be"|t('friends'), url: '#how-tab' },
} %}

{% block content %}
    <input type="hidden" name="action" value="friends/rules/save">
    {{ redirectInput('friends/rules') }}
    {% if rule.id %}<input type="hidden" name="id" value="{{ rule.id }}">{% endif %}

    <div id="what-tab">
        {{ forms.textField({
            first: true,
            label: "Name"|t('app'),
            id: 'name',
            name: 'name',
            value: rule.name,
            required: true,
            errors: rule.getErrors('name'),
        }) }}

        {{ forms.textField({
            label: "Handle"|t('app'),
            id: 'handle',
            name: 'handle',
            class: 'code',
            value: rule.handle,
            required: true,
            errors: rule.getErrors('handle'),
        }) }}

        {{ forms.textareaField({
            label: "Description"|t('app'),
            instructions: "For whoever reads this list in a year."|t('friends'),
            id: 'description',
            name: 'description',
            value: rule.description,
            rows: 2,
        }) }}

        {{ forms.lightswitchField({
            label: "Enabled"|t('app'),
            id: 'enabled',
            name: 'enabled',
            on: rule.enabled,
        }) }}

        {{ forms.selectField({
            label: "Action"|t('friends'),
            instructions: "**Redirect** moves the visitor. **Suggestions** leaves them on your 404 template with a “did you mean” list from `craft.friends.suggestions()`. **Do nothing** matches the URI on purpose and stops — how you exclude a whole branch of the site from every rule below."|t('friends'),
            id: 'ruleAction',
            name: 'ruleAction',
            value: rule.action,
            options: actionOptions,
            errors: rule.getErrors('action'),
        }) }}

        {{ forms.selectField({
            label: "Redirect status"|t('friends'),
            instructions: "Leave on the default until this rule's row in the 404 log convinces you it gets the answer right — a wrong 301 is cached in browsers you cannot reach."|t('friends'),
            id: 'statusCode',
            name: 'statusCode',
            value: rule.statusCode,
            options: statusCodeOptions,
            errors: rule.getErrors('statusCode'),
        }) }}

        {{ forms.selectField({
            label: "If nothing clears the threshold"|t('friends'),
            id: 'fallback',
            name: 'fallback',
            value: rule.fallback,
            options: [
                { value: 'none', label: "Let the next rule try"|t('friends') },
                { value: 'url', label: "Send them somewhere anyway"|t('friends') },
            ],
            toggle: true,
            targetPrefix: '.friends-fallback-',
        }) }}

        <div class="friends-fallback-url {{ rule.fallback == 'url' ? '' : 'hidden' }}">
            {{ forms.textField({
                label: "Fallback URL"|t('friends'),
                instructions: "A site URI like `blog`, or a full URL. Use sparingly: a fallback turns every unresolved 404 under this rule into a redirect, which hides the broken links rather than showing them to you."|t('friends'),
                id: 'fallbackUrl',
                name: 'fallbackUrl',
                class: 'code',
                value: rule.fallbackUrl,
                errors: rule.getErrors('fallbackUrl'),
            }) }}
        </div>
    </div>

    <div id="when-tab" class="hidden">
        {{ forms.textField({
            label: "Only URIs matching"|t('friends'),
            instructions: "A glob like `blog/*`, or `re:` followed by a regular expression. Leave empty for every URI."|t('friends'),
            id: 'uriPattern',
            name: 'uriPattern',
            class: 'code',
            placeholder: 'blog/*',
            value: rule.uriPattern,
            errors: rule.getErrors('uriPattern'),
        }) }}

        {{ forms.editableTableField({
            label: "Except"|t('friends'),
            instructions: "Patterns that disqualify this rule even when the one above matched."|t('friends'),
            id: 'excludePatterns',
            name: 'excludePatterns',
            cols: {
                pattern: { type: 'singleline', heading: "URI pattern"|t('friends'), code: true },
            },
            rows: rule.excludePatterns|map(p => { pattern: p }),
            addRowLabel: "Add a pattern"|t('friends'),
            allowAdd: true,
            allowDelete: true,
            allowReorder: true,
        }) }}

        <div class="flex">
            {{ forms.textField({
                label: "Fewest path segments"|t('friends'),
                id: 'minSegments',
                name: 'minSegments',
                value: rule.minSegments,
                size: 4,
                type: 'number',
                errors: rule.getErrors('minSegments'),
            }) }}

            {{ forms.textField({
                label: "Most path segments"|t('friends'),
                id: 'maxSegments',
                name: 'maxSegments',
                value: rule.maxSegments,
                size: 4,
                type: 'number',
                errors: rule.getErrors('maxSegments'),
            }) }}
        </div>

        {% if siteOptions|length > 1 %}
            {{ forms.checkboxSelectField({
                label: "Sites"|t('app'),
                instructions: "Leave everything unchecked for every site."|t('friends'),
                id: 'siteIds',
                name: 'siteIds',
                values: rule.siteIds,
                options: siteOptions,
            }) }}
        {% endif %}
    </div>

    <div id="where-tab" class="hidden">
        {{ forms.selectField({
            label: "Element type"|t('friends'),
            instructions: "Only types that have URLs are listed — a redirect to an element with no URL is not a redirect."|t('friends'),
            id: 'elementType',
            name: 'elementType',
            value: rule.elementType,
            options: elementTypeOptions,
            errors: rule.getErrors('elementType'),
        }) }}

        <div id="friends-entry-sources" class="{{ rule.elementType == entryTypeClass ? '' : 'hidden' }}">
            {{ forms.checkboxSelectField({
                label: "Sections"|t('app'),
                instructions: "Leave everything unchecked for all of them."|t('friends'),
                id: 'sectionIds',
                name: 'sectionIds',
                values: rule.sectionIds,
                options: sectionOptions,
            }) }}

            {{ forms.checkboxSelectField({
                label: "Entry types"|t('app'),
                id: 'entryTypeIds',
                name: 'entryTypeIds',
                values: rule.entryTypeIds,
                options: entryTypeOptions,
            }) }}
        </div>

        <div id="friends-category-sources" class="{{ rule.elementType == categoryTypeClass ? '' : 'hidden' }}">
            {{ forms.checkboxSelectField({
                label: "Category groups"|t('app'),
                id: 'categoryGroupIds',
                name: 'categoryGroupIds',
                values: rule.categoryGroupIds,
                options: categoryGroupOptions,
            }) }}
        </div>

        {{ forms.textField({
            label: "Only under"|t('friends'),
            instructions: "A URI prefix. Works for every element type, including ones this plugin has never heard of."|t('friends'),
            id: 'uriPrefix',
            name: 'uriPrefix',
            class: 'code',
            placeholder: 'blog',
            value: rule.uriPrefix,
        }) }}

        {{ forms.lightswitchField({
            label: "Live elements only"|t('friends'),
            instructions: "Switching this off lets a disabled page become a redirect target, which is almost always a mistake."|t('friends'),
            id: 'enabledOnly',
            name: 'enabledOnly',
            on: rule.enabledOnly,
        }) }}
    </div>

    <div id="how-tab" class="hidden">
        {{ forms.checkboxSelectField({
            label: "How to find candidates"|t('friends'),
            instructions: "**Exact slug** is the strongest and cheapest — it is what a moved page looks like. **Word overlap** and the **search index** widen the net. **Nearest ancestor page** walks up the path instead of comparing text, and is scored on how much of the path survived."|t('friends'),
            id: 'methods',
            name: 'methods',
            values: rule.methods,
            options: methodOptions,
            errors: rule.getErrors('methods'),
        }) }}

        <div class="field">
            <div class="heading"><label>{{ "Weights"|t('friends') }}</label></div>
            <div class="instructions"><p>{{ "How much each dimension counts. Relative, not out of 100 — 3/1/1 means what it looks like."|t('friends') }}</p></div>
            <div class="flex">
                {{ forms.text({ id: 'weightSlug', name: 'weightSlug', value: rule.weightSlug, size: 4, type: 'number' }) }}
                <span class="light" style="align-self: center;">{{ "slug"|t('friends') }}</span>
                {{ forms.text({ id: 'weightTitle', name: 'weightTitle', value: rule.weightTitle, size: 4, type: 'number' }) }}
                <span class="light" style="align-self: center;">{{ "title"|t('friends') }}</span>
                {{ forms.text({ id: 'weightPath', name: 'weightPath', value: rule.weightPath, size: 4, type: 'number' }) }}
                <span class="light" style="align-self: center;">{{ "path"|t('friends') }}</span>
            </div>
        </div>

        {{ forms.textField({
            label: "Threshold"|t('friends'),
            instructions: "0–100. The whole safety mechanism: below this the rule declines and the next one tries. Start high. The tester will tell you what real URLs score."|t('friends'),
            id: 'threshold',
            name: 'threshold',
            value: rule.threshold,
            size: 4,
            type: 'number',
            errors: rule.getErrors('threshold'),
        }) }}

        {{ forms.textField({
            label: "Candidate limit"|t('friends'),
            instructions: "Leave empty to use the plugin default."|t('friends'),
            id: 'candidateLimit',
            name: 'candidateLimit',
            value: rule.candidateLimit,
            size: 4,
            type: 'number',
            errors: rule.getErrors('candidateLimit'),
        }) }}
    </div>
{% endblock %}

{% if isNew %}{% js %}new Craft.HandleGenerator('#name', '#handle');{% endjs %}{% endif %}

{% js %}
(function() {
    var select = document.getElementById('elementType');
    var entrySources = document.getElementById('friends-entry-sources');
    var categorySources = document.getElementById('friends-category-sources');

    if (!select) {
        return;
    }

    select.addEventListener('change', function() {
        entrySources.classList.toggle('hidden', select.value !== {{ entryTypeClass|json_encode|raw }});
        categorySources.classList.toggle('hidden', select.value !== {{ categoryTypeClass|json_encode|raw }});
    });
})();
{% endjs %}
