{
    "name": "justinholtweb/craft-friend",
    "description": "Every dead URL has a friend. When a page 404s, Friend finds the entry the visitor was probably after and sends them there — under rules you write, with a threshold you set, and a log of every guess it made.",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "404",
        "redirect",
        "seo",
        "similar",
        "fuzzy-matching"
    ],
    "license": "proprietary",
    "homepage": "https://justinholt.com/plugins/craft-friend",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "docs": "https://justinholt.com/plugins/craft-friend/docs",
        "source": "https://github.com/justinholtweb/craft-friend",
        "issues": "https://github.com/justinholtweb/craft-friend/issues"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "craftcms/cms": "^5.3.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\friend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\friend\\tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Friend",
        "handle": "friend",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-friend/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-friend/main/CHANGELOG.md",
        "class": "justinholtweb\\friend\\Plugin"
    }
}
